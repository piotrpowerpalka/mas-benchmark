FROM eclipse-temurin:17-jdk
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends netcat-openbsd curl wget \
 && rm -rf /var/lib/apt/lists/*

COPY ./lib/jade.jar /app/jade.jar
COPY ./jade/*.java /app/.
RUN javac -cp /app/jade.jar:. /app/*.java

# Typowe porty JADE: 1099 (Main Container), 7778 (HTTP MTP/ACC) :contentReference[oaicite:1]{index=1}
EXPOSE 1099 7778

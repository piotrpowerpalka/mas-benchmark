FROM eclipse-temurin:8-jdk
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && command -v nc

COPY ./lib/jade.jar /app/jade.jar
COPY ./jade/*.java /app/
RUN javac -cp /app/jade.jar -d /app /app/*.java \
    && command -v nc \
    && java -version

EXPOSE 1099 7778
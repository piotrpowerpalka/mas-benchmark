import asyncio
from spade.agent import Agent
from spade.behaviour import OneShotBehaviour, CyclicBehaviour
from spade.message import Message
from spade.template import Template 
import random
import string
import time
import uuid
import datetime


class generalAgent(Agent):
    async def setup(self):
        
        self.repetitions = self.get("repetitions-num")

        templateInit = Template()
        templateInit.body = "Start"

        self.add_behaviour(self.ReceiveInit(), templateInit)

    def logMessage(msg: ACLMessage, str: string):
        print("{};{};{};{};{}".format(msg.sender, msg.to, msg.get_metadata("performative"), msg.get_metadata("reply_with"), str, datetime.datetime.now()))
                
    
    
